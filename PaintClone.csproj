<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);WFO1000;CA1416</NoWarn>
    <RootNamespace>PaintClone</RootNamespace>
    <AssemblyName>PaintClone</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.0.0</Version>
    <Description>以 .NET 10 重建的「小畫家」— 功能對等並優化了原版繪圖體驗</Description>
    <SatelliteResourceLanguages>zh-Hant;en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
